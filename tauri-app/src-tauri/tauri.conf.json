{
    "build": {
        "beforeDevCommand": "npm run dev:ui",
        "beforeBuildCommand": "npm run build:ui",
        "devPath": "http://localhost:5173",
        "withGlobalTauri": true
    },
    "package": {
        "productName": "SonarSniffer",
        "version": "0.1.0"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "shell": {
                "all": false,
                "execute": true,
                "open": true,
                "sidecar": true
            },
            "fs": {
                "all": true,
                "readFile": true,
                "writeFile": true,
                "readDir": true,
                "createDir": true,
                "removeDir": true,
                "removeFile": true,
                "copyFile": true
            },
            "path": {
                "all": true
            },
            "dialog": {
                "all": true,
                "open": true,
                "save": true,
                "message": true,
                "ask": true
            },
            "http": {
                "all": true,
                "request": true
            },
            "window": {
                "all": true,
                "create": true,
                "minimize": true,
                "maximize": true,
                "close": true,
                "setFullscreen": true
            }
        },
        "windows": [
            {
                "title": "SonarSniffer",
                "width": 1200,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "focus": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["msi"],
        "identifier": "com.sonarsniffer.desktop",
        "icon": [
            "icons/icon.ico"
        ],
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": "",
            "wix": {
                "language": "en-US",
                "eula": null,
                "license": null,
                "custom_attributes": "InstallScope=\"perMachine\"",
                "fragmentWxs": "<!-- SonarSniffer Installer Fragment -->\n<Fragment>\n  <!-- Create Desktop Shortcut -->\n  <Feature Id=\"DesktopShortcut\" Level=\"1\" Title=\"Create Desktop Shortcut\" Description=\"Create a shortcut on your desktop for easy access\">\n    <ComponentRef Id=\"DesktopShortcutComp\" />\n  </Feature>\n</Fragment>",
                "fragmentFiles": [
                  {
                    "src": "src-tauri/icons/icon.ico",
                    "id": "icon_exe",
                    "name": "SonarSniffer.ico"
                  }
                ],
                "componentWxs": "<!-- Desktop Shortcut Component -->\n<Component Id=\"DesktopShortcutComp\" Guid=\"*\" Win64=\"yes\">\n  <Shortcut Id=\"DesktopShortcut\" Target=\"[INSTALLFOLDER]SonarSniffer.exe\" Name=\"SonarSniffer\" Description=\"SonarSniffer - Sonar Data Analysis Tool\" WorkingDirectory=\"INSTALLFOLDER\" Icon=\"AppIcon.exe\" IconIndex=\"0\" />\n  <RegistryValue Root=\"HKCU\" Key=\"Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run\" Name=\"SonarSniffer\" Value=\"[INSTALLFOLDER]SonarSniffer.exe\" Type=\"string\" KeyPath=\"yes\" />\n</Component>"
            }
        },
        "windowsAttributes": {
            "certificateThumbprint": null,
            "signingIdentity": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": ""
        }
    }
}