{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonarSniffer",
  "version": "0.8.5",
  "identifier": "com.nautidog.sonarsniffer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SonarSniffer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "useLocalToolsDir": true,
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg"
    ],
    "resources": [],
    "externalBin": [
      "binaries/soundtiles",
      "binaries/sonarsniffer-cli",
      "binaries/parse_cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}